# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Git worktrees
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI agent instructions (generated on init, not source-controlled)
CLAUDE.md
AGENTS.md

# Generated DOCX artifacts (upload these to the admin panel, don't commit them)
*.docx

# Resumes and exports used while testing locally
*.pdf

# Local Claude Code settings and session state
.claude/

# Local fixtures used by export diagnostic harness
/tmp/

# Local working notes stay out; architecture decision records are for readers.
docs/*
!docs/adr/



# clerk configuration (can include secrets)
/.clerk/
