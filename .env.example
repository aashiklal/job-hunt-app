# MongoDB
MONGODB_URI=

# Anthropic
ANTHROPIC_API_KEY=

# Clerk Authentication
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=

# Access control
# When "true", new sign-ups are approved instantly on the free plan (a
# one-time $0.50 lifetime AI credit). Leave unset to require admin approval.
AUTO_APPROVE_SIGNUPS=true

# Public URL used in notification links. Vercel sets this automatically;
# set it locally if you want working links in admin emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications (Resend - resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
