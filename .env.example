# Copy to .env.local and fill in. Never commit .env.local.

# Required
MONGODB_URI=
ANTHROPIC_API_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
RESEND_API_KEY=
# onboarding@resend.dev delivers only to your own Resend account address.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public URL used in admin notification links. Optional on Vercel, where
# VERCEL_PROJECT_PRODUCTION_URL is used as a fallback.
NEXT_PUBLIC_APP_URL=

# Optional: public demo (per-visitor private workspaces). Required in
# production for the demo to appear; development falls back to test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
# DEMO_DISABLED=true      # kill switch: hides the demo and refuses new ones
# DEMO_TTL_MINUTES=120    # how long each demo lives
# DEMO_MAX_LIVE=200       # cap on concurrently live demos

# Optional: Telegram admin notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
